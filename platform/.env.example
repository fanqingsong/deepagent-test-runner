# Database Configuration
POSTGRES_DB=cc_test_db
POSTGRES_USER=cc_test_user
POSTGRES_PASSWORD=changeme

# Secret Keys
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# LLM Configuration (GLM)
LLM_API_KEY=
LLM_BASE_URL= https://open.bigmodel.cn/api/coding/paas/v4
LLM_MODEL=glm-4.7
API_TIMEOUT_MS=300000

# JWT Configuration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# SMTP Configuration (for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@example.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REDIS_URL=redis://redis:6379/1

# Temporal Configuration
TEMPORAL_HOST_URL=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=unified-backend-task-queue

# Session Management
MAX_CONCURRENT_SESSIONS=5
SESSION_EXPIRE_HOURS=24
SESSION_REMEMBER_ME_DAYS=30

# MFA Configuration
MFA_TOTP_ISSUER=CC-Test-Runner
MFA_RECOVERY_CODE_COUNT=10

# Casdoor Configuration (optional)
CASDOOR_POSTGRES_PASSWORD=changeme


# Tavily Search API (optional - for web search functionality)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=

# Embedding Configuration (SiliconFlow)
LLM_EMBEDDING_MODEL=BAAI/bge-m3
LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
LLM_EMBEDDING_API_KEY=

# Voice Configuration (SiliconFlow - STT/TTS)
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=TeleAI/TeleSpeechASR
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
MAX_TTS_CHARS=2000

