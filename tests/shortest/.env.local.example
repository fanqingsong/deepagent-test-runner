# Copy to .env.local: cp .env.local.example .env.local

# GLM API key for AI-powered test execution (required)
ZHIPU_API_KEY=your_glm_api_key_here

# Application under test (nginx proxy in dev)
BASE_URL=http://localhost:8080

# Optional: override GLM model and endpoint
# SHORTEST_GLM_MODEL=glm-4-plus
# SHORTEST_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# E2E test user credentials (must exist in the platform database)
E2E_EMAIL=e2e@test.com
E2E_PASSWORD=TestPass123!
